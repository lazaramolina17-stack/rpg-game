# NPM Configuration for slow/unstable networks (Termux/Android)
# These settings prevent timeouts during package installation

# Network timeouts (in milliseconds) - increased for slow connections
fetch-retries=10
fetch-retry-mintimeout=600000
fetch-retry-maxtimeout=600000
fetch-timeout=600000

# Reduce parallel connections to prevent TCP timeouts
maxsockets=1

# Legacy peer deps to avoid unnecessary package resolution
legacy-peer-deps=true

# Disable audit and fund messages (faster, less output)
audit=false
fund=false

# Save exact versions
save-exact=true